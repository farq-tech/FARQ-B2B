def history(r):
    """What this place quoted / declined in past Farq requests (empty when nothing is known)."""
    if r.get('history') is not None: return r['history']
    key = str(r.get('poi_key') or '')
    xs = _MEM_BY_ID.get(key[5:], []) if key.startswith('farq:') else []
    xs = xs or _MEM_BY_PHONE.get(re.sub(r'[^0-9]', '', str(r.get('phone') or '')), [])
    sold = '; '.join(dict.fromkeys(m['items'][:60] for m in xs if m['label'] == 'sells'))
    no = '; '.join(dict.fromkeys(m['items'][:60] for m in xs if m['label'] == 'no'))
    return ' / '.join(x for x in [f'quoted before: {sold}' if sold else '', f'declined, does not sell: {no}' if no else ''] if x)
_CITIES = []
