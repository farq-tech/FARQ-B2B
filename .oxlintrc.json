{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/no-autofocus": "off",
    "react/set-state-in-effect": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn"
  },
  "ignorePatterns": [
    "dist",
    "docs",
    "node_modules"
  ],
  "overrides": [
    {
      "files": [
        "src/lib/canonicalIntent.ts",
        "src/lib/procurementOntology.ts",
        "src/api/*.ts",
        "src/lib/requestFile.ts",
        "src/lib/awardFlow.ts",
        "src/lib/rfqIdentity.ts",
        "src/components/procurement/*.tsx",
        "src/types.ts",
        "src/lib/parseBoq.ts",
        "src/lib/boqPdfTable.ts",
        "src/lib/boqEta.ts",
        "src/lib/lineResolution.ts",
        "src/lib/lineResolution.worker.ts",
        "src/lib/autoPick.ts",
        "src/lib/companyProfile.ts",
        "src/lib/rfqPackages.ts",
        "src/lib/sendGuards.ts",
        "src/lib/imageShrink.ts",
        "src/lib/purchaseRequests.ts"
      ],
      "rules": {
        "no-useless-escape": "off",
        "no-control-regex": "off",
        "no-unused-vars": "off"
      }
    }
  ]
}
