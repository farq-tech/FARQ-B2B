# A standalone, read-only Atlas API for product and end-to-end testing.
# It generates fictional, non-contactable records during the image build.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir duckdb==1.4.5 mapbox-vector-tile==2.2.0 "psycopg[binary]==3.2.13"
COPY server.py market_analytics.py trial_search.py contact_lookup.py buyer_review.py directory_tiles.py status_policy.py taxonomy_search.py read_only_test.py metrics.py index.html ./
COPY test_fixture ./test_fixture
RUN python3 test_fixture/generate.py ./data
ENV PORT=8080 ATLAS_READ_ONLY=1
EXPOSE 8080
CMD ["python3", "server.py"]
