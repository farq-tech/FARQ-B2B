# Dedicated Railway image for the Farq Atlas service.
# It deliberately copies only the Atlas app, leaving the pricing application untouched.
FROM node:22-alpine AS build
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_MAPBOX_TOKEN
ENV NEXT_PUBLIC_MAPBOX_TOKEN=$NEXT_PUBLIC_MAPBOX_TOKEN

RUN corepack enable
COPY apps/atlas/package.json apps/atlas/pnpm-lock.yaml apps/atlas/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/atlas/ ./
RUN pnpm build

FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public

EXPOSE 3000
CMD ["sh", "-c", "node_modules/.bin/next start -p ${PORT:-3000}"]
