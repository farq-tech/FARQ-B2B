# Copy to .env.production.local. This file is ignored by Git.
# Keep the values private; do not paste a production .env into source control.
FARQ_LOCAL_PORT=8080
ALLOWED_EMAILS=abdulrhman@farq.sa
VITE_ALLOWED_EMAILS=abdulrhman@farq.sa

# Match the deployed map visual when you have the existing public Mapbox token.
VITE_MAPBOX_TOKEN=

# The local container uses the same upstreams as production for authenticated reads.
FARQ_API_ORIGIN=https://api.farq.sa
TARGETING_ORIGIN=https://farq-targeting-production-4687.up.railway.app
TARGETING_PASSWORD=
TARGETING_SERVICE_TOKEN=

# Use a new local-only secret of at least 32 characters.
FARQ_SESSION_SECRET=
